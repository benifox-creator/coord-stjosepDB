# Firebase — obtenir a: console.firebase.google.com → coord-stjosep → Config app web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=coord-stjosep.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=coord-stjosep
VITE_FIREBASE_STORAGE_BUCKET=coord-stjosep.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud — obtenir a: console.cloud.google.com → Credencials → OAuth 2.0
VITE_GOOGLE_CLIENT_ID=

# Supabase — obtenir a: app.supabase.com → Project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry — obtenir a: sentry.io → Projects → coord-stjosepDB → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
